{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llm-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llm-server (vllm)",
      "options": {
        "baseURL": "http://vllm:8000/v1"
      },
      "models": {
        "qwen38-turbo": {
          "name": "Qwen3.8-27B Turbo Q6_K",
          "attachment": true,
          "reasoning": true,
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          },
          "tool_call": true,
          "limit": {
            "context": 131072,
            "input": 98304,
            "output": 32768
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "reasoningEffort": "xhigh"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen38": {
          "name": "Qwen3.8-27B GPTQ-INT4",
          "attachment": true,
          // modalities is what actually gates image input. Without it opencode
          // tells the model a file was attached instead of sending the image,
          // and the model correctly replies that it cannot see anything.
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "reasoning_effort": "xhigh"
          }
        }
      }
    }
  },
  "model": "llm-server/qwen38"
}
