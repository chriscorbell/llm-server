# Copy to .env on the server and fill in. .env is gitignored.

# Pinned by digest. Never use a floating tag. Bump only in a logged Experiment.
# vLLM 0.27.2rc1.dev77, vllm-xpu-kernels 0.1.12.3
VLLM_IMAGE=vllm/vllm-openai-xpu@sha256:f01e24f6c7ff01f1e0662234255a1372297d1dbd89d003cf13c8fad3eab1ba4f

# Model checkout, pinned to revision 9d189a60e4c0ad7f9f47cd94bfa393ca10b3924e.
MODEL_DIR=/home/chris/models/Qwen3.8-27B-GPTQ-Int4-sym-G128-MTP-BF16
SERVED_NAME=qwen38

# SearXNG for Pi's web_search tool, pinned by digest (2026.9.7-3e454637f).
# Generate the secret with: openssl rand -hex 32
SEARXNG_IMAGE=searxng/searxng@sha256:1dab138ea70a8ceb4d1c182f5c8f256088406c1742b99e279976157dbe1e9759
SEARXNG_PORT=8080
SEARXNG_SECRET=change-me

# Tailscale address of vllm. Do not change to 0.0.0.0.
BIND_ADDR=100.103.136.98
PORT=8000
API_KEY=change-me

# Fill from: stat -c '%g' /dev/dri/render*
RENDER_GID=991

# Context. The historical profile name says BF16, but `--dtype float16` plus
# `--kv-cache-dtype auto` makes the running 16-bit cache FP16. 98,304 is the
# verified daily-driver limit at 0.95 utilization. FP8 is an experimental arm.
MAX_MODEL_LEN_BF16KV=98304
MAX_MODEL_LEN_FP8KV=131072

GPU_UTIL=0.95

# Single sequence. Raising this above 1 requires patch_gdn_mixed_split_v5.py and
# lowers MTP acceptance and needs mixed-batch validation on this XPU stack.
MAX_NUM_SEQS=1
MAX_BATCHED_TOKENS=8192

# Depth 3 measured equal or faster than 4 and holds 2,314 more KV tokens.
# See docs/log/2026-09-07-mtp-depth-3.md before changing.
MTP_TOKENS=3
TOOL_PARSER=qwen3_xml
REASONING_PARSER=qwen3

# Optional CPU pinning for the engine core loop. Empty means unpinned.
# On the 3970X, "0-3,32-35" is one four-core CCX plus its SMT siblings.
CPUSET=
